{
  "manifest_version": 3,
  "name": "Geo Spoof",
  "version": "0.1.0",
  "description": "Override navigator.geolocation with a chosen location.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "Geo Spoof" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
